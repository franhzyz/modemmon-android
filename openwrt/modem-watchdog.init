#!/bin/sh /etc/rc.common
# Служба-сторож модема: держит modem-watchdog.sh живым и перезапускает при падении.

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/modem-watchdog.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "medvemodem"
}
